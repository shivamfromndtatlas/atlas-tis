# Copy to .env and adjust. Never commit .env.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL (docker compose defaults). Set DATABASE_URL=sqlite:///db.sqlite3 to run without MySQL.
DATABASE_URL=mysql://tis:tis@127.0.0.1:3306/tis

REDIS_URL=redis://127.0.0.1:6379/0
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Email: console backend in dev; SMTP/anymail in staging/prod
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=NDT Atlas Careers <no-reply@localhost>

# Files
MEDIA_ROOT=./media
FILE_SCANNER=none
